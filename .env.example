# ==========================================================
#  pegazo_back — Variables de entorno
#  Copia este archivo a .env y rellena los valores reales.
# ==========================================================

# Puerto del servidor
PORT=3002

# Entorno de ejecución: development | production
NODE_ENV=development

# --- Base de datos (PostgreSQL / Prisma) ---
DATABASE_URL="postgresql://usuario:password@localhost:5432/pegazo?schema=public"

# --- JWT (OBLIGATORIO) ---
# Genera un secreto fuerte, por ejemplo:  openssl rand -base64 48
JWT_SECRET=
# Duración del token (por defecto 1d)
JWT_EXPIRES_IN=1d

# --- CORS ---
# Orígenes (dominios del frontend) permitidos, separados por coma.
# En producción es OBLIGATORIO definirlos; vacío en dev permite todos.
CORS_ORIGINS=https://pegazo.co,http://localhost:3000

# --- Cloudinary (imágenes) ---
# El SDK lee CLOUDINARY_URL automáticamente. Formato:
# cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# --- Wompi (pasarela de pago) ---
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
