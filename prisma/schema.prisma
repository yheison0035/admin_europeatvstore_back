generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Cambia a mysql o sqlite si usas otro
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////

enum Role {
  SUPER_ADMIN
  COORDINADOR
  ADMIN
  ASESOR
  AUXILIAR
  BODEGUERO
  VENTAS
  SUPER_PLATFORM_ADMIN
  BARBERO
  CAJA
  RECEPCIONISTA
  MESERO
  COCINERO
  PROFESIONAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id        Int         @id @default(autoincrement())
  entity    String
  entityId  Int
  action    AuditAction
  changes   Json?
  userId    Int?
  userName  String
  companyId Int
  createdAt DateTime    @default(now())

  @@index([entity, entityId])
  @@index([companyId])
}

enum Status {
  ACTIVO
  INACTIVO
  PENDIENTE
  ELIMINADO
}

enum PaymentMethod {
  EFECTIVO
  BANCOLOMBIA
  TRANSFERENCIA
  DATAFONO
  ADDI
  CREDITO
}

enum PaymentStatus {
  PENDIENTE
  EN_VALIDACION
  PLAN_SEPARE
  PAGADA
  RECHAZADA
  VENCIDO
  REEMBOLSADO
  ANULADO
  FIADO
}

enum SaleStatus {
  NUEVA
  EN_PROCESO
  PENDIENTE
  APROBADA
  RECHAZADA
  CANCELADA
  FACTURADA
  DESPACHADA
  ENTREGADA
  DEVUELTA
}

enum ExpenseType {
  ARRIENDO
  SERVICIOS_PUBLICOS
  EMPLEADOS
  TRANSPORTE
  PEDIDOS
  PLAN_CELULAR
  PLAN_INTERNET
  ASEO
  MANTENIMIENTO
  PUBLICIDAD
  IMPUESTOS
  COMISIONES
  OTROS
}

enum OrderSource {
  CRM
  ECOMMERCE
}

enum ShippingStatus {
  PENDIENTE
  ASIGNADO_TRANSPORTADORA
  EN_CAMINO
  ENTREGADO
  DEVUELTO
  FALLIDO
}

enum BusinessType {
  COMERCIO
  FERIA
  TELEVENTAS
  RESTAURANTE
  SERVICIOS
  ECOMMERCE
  DISTRIBUCION
  ZORVEX
  // Verticales específicas (multi-negocio)
  ODONTOLOGIA
  SUPERMERCADO
  DROGUERIA
  ROPA
  FRUVER
  FLORISTERIA
  COMIDA_RAPIDA
  CAFETERIA
  CARNICERIA
}

enum DiscountType {
  PERCENT // porcentaje sobre el precio del plan (0-100)
  FIXED // monto fijo en COP
}

// Cupones de descuento gestionados por el SUPER_PLATFORM_ADMIN. Se pueden
// aplicar en el registro para descontar sobre el precio del plan elegido.
model Coupon {
  id             Int          @id @default(autoincrement())
  code           String       @unique
  description    String?
  discountType   DiscountType @default(PERCENT)
  discountValue  Int          @default(0) // % (0-100) o monto fijo en COP
  appliesToPlan  String? // null = todos los planes; o un id de plan (DESPEGUE, IMPULSO, ...)
  maxRedemptions Int? // null = ilimitado
  timesRedeemed  Int          @default(0)
  expiresAt      DateTime? // null = sin vencimiento
  active         Boolean      @default(true)
  status         Status       @default(ACTIVO) // para borrado lógico
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum AppointmentStatus {
  PENDIENTE
  CONFIRMADA
  EN_PROCESO
  COMPLETADA
  CANCELADA
  NO_ASISTIO
}

enum WebsiteBannerType {
  HOME
  CATEGORY
  OFFER
  POPUP
}

// Tipo de factura (normal vs electrónica DIAN).
enum InvoiceType {
  NORMAL
  ELECTRONICA
}

//////////////////////////////////////////////////
// MODELOS
//////////////////////////////////////////////////

model Company {
  id      Int          @id @default(autoincrement())
  name    String
  logo    String?
  nit     String?
  email   String?
  // Clave del tipo de negocio. Es TEXTO (no enum) para permitir tipos nuevos
  // creados desde la plataforma (BusinessTypeConfig). El enum BusinessType se
  // conserva como catálogo de referencia/semilla de los 17 tipos base.
  type    String       @default("COMERCIO")
  status  Status       @default(ACTIVO)
  phone   String?
  manager String?

  // Fidelización por visitas con dos escalones de descuento. Ej. barbería:
  // a la visita 4 -> 50% en ese corte, a la visita 8 -> 100% (y reinicia).
  // Entre visita y visita hay un máximo de días; si se pasa, la racha reinicia.
  loyaltyEnabled      Boolean @default(false)
  loyaltyTier1Visits  Int     @default(4)
  loyaltyTier1Percent Int     @default(50)
  loyaltyTier2Visits  Int     @default(8)
  loyaltyTier2Percent Int     @default(100)
  loyaltyMaxDays      Int     @default(25)

  // (Legado) esquema anterior de sellos + premio; se conserva por compatibilidad.
  loyaltyStampsRequired Int    @default(10)
  loyaltyReward         String @default("1 servicio gratis")

  // Horario de atención (hora 0-23) — usado por la disponibilidad de citas.
  openHour  Int @default(9)
  closeHour Int @default(20)

  // Tema de diseño del panel/CRM elegido por el dueño (orange | blue | emerald).
  crmTheme String @default("orange")
  crmFont  String @default("system")

  // Overrides de vocabulario propios de la empresa (barbería vs estética, etc.).
  // Se fusionan sobre los términos por tipo de negocio. Ej: { "attendant": "Especialista" }
  terminology Json?

  // Si está activo, no se puede vender sin haber "abierto el día" (caja abierta
  // de hoy en la sede). El dueño lo enciende/apaga en Configuración.
  requireCashOpen Boolean @default(false)

  // Configuración fiscal (facturación con impuestos / electrónica DIAN).
  responsableIVA     Boolean @default(false)
  preciosIncluyenIVA Boolean @default(false)
  defaultTaxRate     Decimal @default(0) @db.Decimal(5, 2)
  businessName       String?
  dv                 String?
  personType         String?
  taxRegime          String?
  ciiu               String?
  fiscalAddress      String?
  fiscalCity         String?

  // Facturación / suscripción (control de la plataforma)
  plan       String?
  paidUntil  DateTime? // fecha hasta la que la empresa está al día; si vence, se auto-suspende
  startDate  DateTime? // fecha en que la empresa empezó con nosotros (si null, se usa createdAt)
  couponCode String? // cupón de descuento con el que se registró (informativo)

  // Control MANUAL de módulos por empresa (superplatform). Si tiene valores,
  // manda sobre el plan: el cliente solo ve/usa los módulos de esta lista.
  // Vacío = comportamiento por defecto (según su tipo de negocio/plan).
  enabledModules String[] @default([])

  // Precio acordado con el cliente (COP/mes) y descuento inicial por tiempo
  // (informativo/manual: se muestra en el superplatform, el cobro es manual).
  monthlyPrice    Int?
  discountedPrice Int? // precio durante el descuento inicial
  discountUntil   DateTime? // hasta cuándo aplica el precio con descuento

  //////////////////////////////////////////////////
  // WEBSITE
  //////////////////////////////////////////////////

  domain         String? @unique
  slug           String? @unique
  websiteEnabled Boolean @default(false)
  websiteName    String?
  favicon        String?
  theme          String  @default("default")
  fontFamily     String? // tipografía de la tienda (clave, no la fuente completa)
  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  ctaColor       String? // color de los botones de compra
  heroTitle      String?
  heroSubtitle   String?

  // Pasarela de pagos PROPIA de la tienda online (Wompi por empresa). Cada
  // negocio conecta su cuenta Wompi y el dinero cae en SU banco; Pegazo no lo
  // toca. La llave pública se expone a la tienda; los secretos se OMITEN
  // globalmente (ver prisma.service.ts) igual que mailPassword.
  wompiEnabled         Boolean @default(false)
  wompiPublicKey       String?
  wompiIntegritySecret String?
  wompiEventsSecret    String?
  wompiPrivateKey      String?

  // Correo propio del negocio (SMTP) para enviar sus correos (p. ej. el
  // restablecimiento de contraseña de sus clientes) DESDE su propia cuenta.
  // mailPassword se omite globalmente en las respuestas (igual que la del cliente).
  mailHost      String?
  mailPort      Int?
  mailUser      String?
  mailPassword  String?
  mailFromName  String?
  mailFromEmail String?

  //////////////////////////////////////////////////

  users          User[]
  locals         Local[]
  provider       Provider[]
  categories     Category[]
  brand          Brand[]
  customers      Customer[]
  services       Service[]
  appointments   Appointment[]
  websiteBanners WebsiteBanner[]
  websiteSetting WebsiteSetting?
  mesas          Mesa[]
  comandas       Comanda[]
  salePayments   SalePayment[]
  inventory      Inventory[]     @relation("CompanyInventory")
  cashRegisters  CashRegister[]
  purchases      Purchase[]
  quotes         Quote[]
  returns        Return[]
  supplies       Supply[]
  bankDeposits   BankDeposit[]
  bankProcessedEmails BankProcessedEmail[]

  // Notificaciones de consignaciones a la cuenta del banco (SMS/correo reenviado).
  bankNotifyEnabled Boolean @default(false)
  // Facturación electrónica DIAN habilitada por la plataforma para esta empresa
  // (muestra el módulo/menú y su configuración; se emite vía Factus).
  electronicInvoicingEnabled Boolean @default(false)
  // Secreto del webhook. NO es único: varias empresas que comparten el mismo
  // buzón/cuenta usan el mismo token y se distinguen por bankIdentifier.
  bankNotifyToken   String?
  // Cómo se identifica esta empresa en la notificación del banco (nombre y/o
  // llave del QR, separados por coma). Ej: "RAGNOR BARBER, @ragnorbarber".
  bankIdentifier    String?
  // Correo donde el negocio recibe las confirmaciones del banco (informativo /
  // para las instrucciones del reenviador). Ej: "ragnor.pagos@gmail.com".
  bankEmail         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Consignación/transferencia recibida en la cuenta del banco de la empresa,
// detectada al parsear el SMS de Bancolombia reenviado por el celular.
model BankDeposit {
  id         Int      @id @default(autoincrement())
  amount     Float    @default(0)
  senderName String? // nombre de quien consignó (si el SMS lo trae)
  reference  String? // referencia/últimos dígitos si vienen en el SMS
  raw        String? // texto original del SMS (respaldo)
  seen       Boolean  @default(false)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([seen])
}

// Registro PERSISTENTE de correos del banco ya procesados por empresa. Sirve
// para NO volver a crear una consignación aunque el reenviador mande el mismo
// correo otra vez, incluso si el usuario ya borró esa consignación del historial.
model BankProcessedEmail {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceKey String // id del correo (Gmail) o hash del texto
  createdAt DateTime @default(now())

  @@unique([companyId, sourceKey])
  @@index([companyId])
}

model User {
  id         Int       @id @default(autoincrement())
  role       Role      @default(ASESOR)
  name       String    @default("SIN NOMBRE")
  email      String    @unique
  phone      String?
  address    String?
  birthdate  DateTime?
  document   String?
  department String?
  city       String?
  status     Status    @default(ACTIVO)
  password   String
  avatar     String?

  // Comisiones del empleado (porcentaje 0–100). NULL = sin configurar: no se
  // calcula ganancia y se avisa al administrador. Aplica a cualquier empleado
  // que preste servicios o venda productos (dinámico, no solo barberos).
  commissionServiceRate Decimal? @db.Decimal(5, 2) // % por servicios/cortes
  commissionProductRate Decimal? @db.Decimal(5, 2) // % por productos

  // Código OTP para restablecer contraseña por celular (WhatsApp)
  resetOtpHash     String?
  resetOtpExpires  DateTime?
  resetOtpAttempts Int       @default(0)

  localId Int?
  local   Local? @relation("LocalUsers", fields: [localId], references: [id], onDelete: SetNull)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  managedLocals      Local[]       @relation("LocalManager")
  createdInventories Inventory[]   @relation("InventoryCreatedBy")
  updatedInventories Inventory[]   @relation("InventoryUpdatedBy")
  services           Service[]     @relation("BarberServices")
  appointments       Appointment[] @relation("BarberAppointments")
  // Descansos: días de la semana recurrentes (0=Dom..6=Sáb) y fechas puntuales.
  restWeekdays Int[]            @default([])
  timeOff      EmployeeTimeOff[]

  sales    Sale[]    @relation("UserSales")
  comandas Comanda[]

  cashOpened    CashRegister[] @relation("CashOpenedBy")
  cashClosed    CashRegister[] @relation("CashClosedBy")
  cashMovements CashMovement[] @relation("CashMovementUser")
  salePayments  SalePayment[]  @relation("UserSalePayments")
  purchases     Purchase[]     @relation("PurchaseUser")
  quotes        Quote[]        @relation("QuoteUser")
  returns       Return[]       @relation("ReturnUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////

model Customer {
  id            Int     @id @default(autoincrement())
  type_document String?
  document      String?
  name          String
  email         String?
  phone         String?
  department    String?
  city          String?
  address       String?
  status        Status  @default(ACTIVO)

  // Origen del cliente: creado en el CRM por el negocio, o registrado desde la
  // tienda online (ecommerce). Sirve para saber de dónde viene cada cliente.
  source CustomerSource @default(CRM)

  // Contraseña (hash bcrypt) solo para clientes que inician sesión en la tienda
  // online. Los clientes creados por el CRM la tienen en null.
  password String?

  // Fecha de nacimiento (para campañas de cumpleaños) y notas del asesor
  // (preferencias, observaciones del cliente).
  birthday DateTime?
  notes    String?

  // Fidelización: sellos acumulados hacia el próximo premio y premios ganados
  // pendientes de canjear.
  loyaltyStamps    Int       @default(0)
  loyaltyRewards   Int       @default(0)
  loyaltyLastVisit DateTime? // última visita que sumó a la fidelización
  // Cliente "graduado": ya completó el rango de fidelización (llegó al tope).
  // La fidelización queda desactivada para él de forma permanente (ya es
  // cliente antiguo y paga normal); se lista aparte para futuras ofertas.
  loyaltyCompleted Boolean   @default(false)
  // Graduado MANUAL por el dueño (ej. se le completó la tarjeta por cortesía):
  // se respeta aunque los sellos se recalculen desde las ventas.
  loyaltyManualComplete Boolean @default(false)

  // Última vez que se le escribió para reactivarlo (campaña de win-back).
  lastWinbackAt DateTime?

  localId Int?
  local   Local? @relation(fields: [localId], references: [id], onDelete: SetNull)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  sales        Sale[]        @relation("CustomerSales")
  appointments Appointment[]
  quotes       Quote[]

  // Perfil(es) de la tienda online (datos de envío/facturación) enlazados a
  // este cliente del CRM.
  ecommerceProfiles EcommerceCustomer[] @relation("CustomerEcommerceProfiles")

  // Segmento/etiqueta administrable del cliente (mayorista, VIP…), opcional.
  segmentId Int?
  segment   CustomerSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([document, companyId])
}

enum CustomerSource {
  CRM
  ECOMMERCE
}

//////////////////////////////////////////////////

model Provider {
  id          Int     @id @default(autoincrement())
  name        String
  contactName String?
  phone       String?
  email       String?
  city        String?
  department  String?
  address     String?
  productType String?
  status      Status  @default(ACTIVO)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  inventories Inventory[] @relation("ProviderProducts")
  expenses    Expense[]   @relation("ProviderExpenses")
  purchases   Purchase[]
  supplies    Supply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////

model Local {
  id         Int     @id @default(autoincrement())
  name       String
  address    String?
  department String?
  city       String?
  phone      String?
  status     Status  @default(ACTIVO)

  managerId Int?
  manager   User? @relation("LocalManager", fields: [managerId], references: [id])

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  users           User[]           @relation("LocalUsers")
  inventories     Inventory[]      @relation("LocalInventory")
  expenses        Expense[]        @relation("LocalExpenses")
  sales           Sale[]           @relation("LocalSales")
  categories      Category[]       @relation("LocalCategory")
  brand           Brand[]          @relation("LocalBrand")
  appointments    Appointment[]
  customers       Customer[]
  serviceLocals   ServiceLocal[]
  websiteSettings WebsiteSetting[]
  mesas           Mesa[]
  comandas        Comanda[]
  cashRegisters   CashRegister[]
  purchases       Purchase[]
  quotes          Quote[]
  returns         Return[]
  supplies        Supply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////

model Category {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  status      Status  @default(ACTIVO)
  localId     Int?
  // ¿Los productos de esta categoría generan comisión al empleado? (Ej. insumos
  // sí; cervezas/bebidas no.) Por defecto NO: solo pagan las que se marquen.
  earnsCommission Boolean @default(false)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  inventories Inventory[] @relation("CategoryProducts")
  local       Local?      @relation("LocalCategory", fields: [localId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////

model Brand {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  status      Status  @default(ACTIVO)
  localId     Int?

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  inventories Inventory[] @relation("BrandProducts")
  local       Local?      @relation("LocalBrand", fields: [localId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////

model Inventory {
  id                 Int     @id @default(autoincrement())
  name               String
  description        String?
  slug               String? @unique
  purchasePrice      Float
  oldPrice           Float?
  salePrice          Float
  taxRate            Decimal @default(0) @db.Decimal(5, 2)
  status             Status  @default(ACTIVO)
  barcode            String? @unique
  publishInEcommerce Boolean @default(false)

  // Umbral de alerta de stock bajo (0 = sin alerta). Se compara contra el stock
  // total del producto (suma de variantes).
  minStock Int @default(0)

  // Unidad de venta: UNIDAD (por unidad) o PESO (por kg, admite decimales).
  unit String @default("UNIDAD")

  // ¿Se controla el inventario/stock de este producto? (como el "Track quantity"
  // de Shopify/Square). true = producto con existencias (bebidas, retail); false
  // = elaborado al momento sin stock (platos de un menú), se puede vender siempre.
  trackStock Boolean @default(true)

  // Vencimiento y lote (droguería / perecederos). Opcionales.
  expiryDate DateTime?
  lot        String?

  // Ancla de tenant: el producto pertenece a una empresa (no depende del local,
  // que puede quedar en null si se borra la sede). Nullable por 3 filas antiguas
  // huérfanas sin empresa resoluble; los productos nuevos siempre lo llevan.
  companyId  Int?
  localId    Int?
  providerId Int?
  categoryId Int?
  brandId    Int?

  createdById Int?
  updatedById Int?

  createdBy User?     @relation("InventoryCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("InventoryUpdatedBy", fields: [updatedById], references: [id])
  company   Company?  @relation("CompanyInventory", fields: [companyId], references: [id], onDelete: Cascade)
  local     Local?    @relation("LocalInventory", fields: [localId], references: [id], onDelete: SetNull)
  provider  Provider? @relation("ProviderProducts", fields: [providerId], references: [id], onDelete: SetNull)
  category  Category? @relation("CategoryProducts", fields: [categoryId], references: [id], onDelete: SetNull)
  // Unidad de medida del catálogo administrable (opcional). El string `unit`
  // (UNIDAD|PESO) se deriva de su code para la lógica del POS.
  unitId        Int?
  unitOfMeasure UnitOfMeasure? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  brand     Brand?    @relation("BrandProducts", fields: [brandId], references: [id], onDelete: SetNull)

  variants       InventoryVariant[]
  images         InventoryImage[]
  features       InventoryFeature[]
  specifications InventorySpecification[]
  recipeItems    RecipeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([localId])
  @@index([categoryId])
  @@index([brandId])
  @@index([providerId])
  @@index([status])
}

model InventoryVariant {
  id       Int     @id @default(autoincrement())
  sequence Int     @unique @default(autoincrement())
  color    String
  size     String? // talla (ropa/calzado); opcional
  stock    Float   @default(0) // admite decimales para venta por peso (kg)
  sku      String  @unique

  isActive Boolean @default(true)

  inventoryId Int

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryImage {
  id          Int    @id @default(autoincrement())
  url         String
  publicId    String
  inventoryId Int
  position    Int    @default(0)

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model InventoryFeature {
  id          Int    @id @default(autoincrement())
  title       String
  inventoryId Int
  order       Int    @default(0)

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model InventorySpecification {
  id          Int    @id @default(autoincrement())
  key         String
  value       String
  inventoryId Int
  order       Int    @default(0)

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

//////////////////////////////////////////////////

model Expense {
  id            Int            @id @default(autoincrement())
  concept       String
  type          ExpenseType
  amount        Float
  paymentMethod PaymentMethod?
  paidTo        String?
  notes         String?
  status        Status         @default(ACTIVO)
  expenseDate   DateTime

  providerId Int?
  localId    Int
  // Categoría administrable por el negocio (opcional). El enum `type` se
  // mantiene sincronizado para compatibilidad (payables/estadísticas legacy).
  expenseCategoryId Int?

  provider Provider? @relation("ProviderExpenses", fields: [providerId], references: [id], onDelete: SetNull)
  local    Local     @relation("LocalExpenses", fields: [localId], references: [id], onDelete: Cascade)
  expenseCategory ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([localId])
  @@index([expenseDate])
  @@index([type])
  @@index([expenseCategoryId])
}

// Fechas puntuales de descanso/ausencia de un empleado (vacaciones, día libre…).
model EmployeeTimeOff {
  id        Int      @id @default(autoincrement())
  companyId Int
  userId    Int
  date      DateTime // día completo de descanso (medianoche UTC del día)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([companyId])
}

// Segmentos/etiquetas de cliente administrables por empresa (MAYORISTA, VIP…).
model CustomerSegment {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  status    Status   @default(ACTIVO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers Customer[]

  @@index([companyId])
}

// Unidades de medida administrables por empresa (UNIDAD, KG, LITRO, CAJA…).
// `code` (UNIDAD|PESO) define si la cantidad admite decimales (peso) o no.
model UnitOfMeasure {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  code      String   @default("UNIDAD")
  status    Status   @default(ACTIVO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Inventory[]

  @@index([companyId])
}

// Métodos de pago administrables por cada empresa. `code` es el comportamiento
// base (enum PaymentMethod): así "Nequi" puede comportarse como TRANSFERENCIA
// (va al banco) y la caja/estadísticas siguen funcionando por el enum.
model PaymentMethodCatalog {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  code      PaymentMethod
  status    Status   @default(ACTIVO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@index([companyId])
}

// Tipos de cargo a empleado administrables por cada empresa (CRUD del dueño).
model ChargeCategory {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  code      String?
  status    Status   @default(ACTIVO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charges EmployeeCharge[]

  @@index([companyId])
}

// Tipos/categorías de gasto administrables por cada empresa (CRUD del dueño).
model ExpenseCategory {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  // Si corresponde a un tipo base, guarda el valor del enum ExpenseType para
  // derivar `Expense.type` y no romper estadísticas/payables.
  code      String?
  status    Status   @default(ACTIVO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@index([companyId])
}

//////////////////////////////////////////////////

model Sale {
  id            Int           @id @default(autoincrement())
  code          String        @unique
  totalAmount   Float
  subtotal      Decimal?      @db.Decimal(14, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(14, 2)
  invoiceType   InvoiceType   @default(NORMAL)
  paymentMethod PaymentMethod
  saleStatus    SaleStatus    @default(NUEVA)
  paymentStatus PaymentStatus @default(PENDIENTE)
  saleDate      DateTime      @default(now())
  dueDate       DateTime? // vencimiento de la venta a crédito (fiado)
  notes         String?
  cashReceived  Float? // efectivo con el que pagó el cliente (para calcular el cambio en la factura)
  // Venta sin comisión para el empleado (ej. corte de cortesía / mal aplicado):
  // no le genera comisión, aunque siga contando el total de la venta.
  noCommission  Boolean @default(false)

  source              OrderSource @default(CRM)
  ecommerceCustomerId Int?

  shippingStatus ShippingStatus @default(PENDIENTE)

  wompiTransactionId String?
  wompiReference     String?
  wompiStatus        String?
  wompiPayload       Json?

  customerId    Int?
  localId       Int
  userId        Int?
  appointmentId Int?

  ecommerceCustomer EcommerceCustomer? @relation("EcommerceOrders", fields: [ecommerceCustomerId], references: [id])

  // Método de pago del catálogo administrable (opcional); `paymentMethod` (enum)
  // se deriva de su code para la lógica de caja/banco/estadísticas.
  paymentMethodCatalogId Int?
  paymentMethodCatalog   PaymentMethodCatalog? @relation(fields: [paymentMethodCatalogId], references: [id], onDelete: SetNull)

  local       Local        @relation("LocalSales", fields: [localId], references: [id], onDelete: Cascade)
  user        User?        @relation("UserSales", fields: [userId], references: [id], onDelete: SetNull)
  customer    Customer?    @relation("CustomerSales", fields: [customerId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation("AppointmentSales", fields: [appointmentId], references: [id])

  items SaleItem[] @relation("SaleItems")

  shipment Shipment?

  cashMovements CashMovement[]
  returns       Return[]
  payments      SalePayment[]  @relation("SalePayments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([localId])
  @@index([userId])
  @@index([saleDate])
  @@index([customerId])
  @@index([paymentStatus])
}

//////////////////////////////////////////////////
// Abonos / pagos parciales de una venta a crédito (cartera / fiado)
//////////////////////////////////////////////////

model SalePayment {
  id     Int           @id @default(autoincrement())
  amount Decimal       @db.Decimal(14, 2)
  method PaymentMethod @default(EFECTIVO)
  note   String?
  paidAt DateTime      @default(now())

  saleId      Int
  companyId   Int
  createdById Int?

  sale      Sale    @relation("SalePayments", fields: [saleId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("UserSalePayments", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([companyId])
}

//////////////////////////////////////////////////
// Tabla intermedia para los productos vendidos
//////////////////////////////////////////////////

model SaleItem {
  id        Int     @id @default(autoincrement())
  quantity  Float // admite decimales para venta por peso (kg)
  price     Float
  subtotal  Float
  discount  Float   @default(0)
  taxRate   Decimal @default(0) @db.Decimal(5, 2)
  taxAmount Decimal @default(0) @db.Decimal(14, 2)

  saleId             Int
  inventoryVariantId Int?
  serviceId          Int?

  sale    Sale              @relation("SaleItems", fields: [saleId], references: [id], onDelete: Cascade)
  variant InventoryVariant? @relation(fields: [inventoryVariantId], references: [id])
  service Service?          @relation(fields: [serviceId], references: [id])

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([inventoryVariantId])
  @@index([serviceId])
}

//////////////////////////////////////////////////
// ECOMMERCE
//////////////////////////////////////////////////

model EcommerceCustomer {
  id Int @id @default(autoincrement())

  email     String @unique
  firstName String
  lastName  String
  phone     String

  documentNumber String?

  department    String
  city          String
  address       String
  addressDetail String?
  neighborhood  String?

  billingSameAsShipping Boolean @default(true)
  billingFirstName      String?
  billingLastName       String?
  billingPhone          String?
  billingAddress        String?

  isHardToAccess Boolean @default(false)

  localId Int @default(3)

  // Cliente del CRM (identidad unificada) al que pertenece este perfil de
  // tienda. Se enlaza cuando el cliente se registra/inicia sesión o al comprar.
  customerId Int?
  customer   Customer? @relation("CustomerEcommerceProfiles", fields: [customerId], references: [id], onDelete: SetNull)

  orders Sale[] @relation("EcommerceOrders")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shipment {
  id Int @id @default(autoincrement())

  saleId Int            @unique
  status ShippingStatus @default(PENDIENTE)

  carrier        String?
  trackingNumber String?

  shippedAt   DateTime?
  deliveredAt DateTime?
  notes       String?

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// BARBERIA

model Service {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  duration    Int
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  status      Status  @default(ACTIVO)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  serviceLocals ServiceLocal[]

  barbers      User[]        @relation("BarberServices")
  appointments Appointment[]
  saleItems    SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceLocal {
  id Int @id @default(autoincrement())

  price Float

  serviceId Int
  localId   Int

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  local   Local   @relation(fields: [localId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([serviceId, localId])
}

model Appointment {
  id Int @id @default(autoincrement())

  date      DateTime
  startTime String
  // Minutos desde medianoche (derivado de startTime) para ordenar por hora real
  // de reloj, ya que startTime se guarda en 12h ("01:00 p. m.") y no ordena bien.
  startMinutes Int @default(0)

  status AppointmentStatus @default(CONFIRMADA)
  notes  String?

  // Confirmación explícita con el cliente (p. ej. tras contactarlo por WhatsApp).
  clientConfirmed Boolean @default(false)

  // Ya se le envió al barbero el recordatorio push previo a la cita.
  reminderSent Boolean @default(false)

  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id])

  barberId Int
  barber   User @relation("BarberAppointments", fields: [barberId], references: [id])

  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id])

  localId Int
  local   Local @relation(fields: [localId], references: [id])

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[] @relation("AppointmentSales")

  @@index([serviceId])
  @@index([companyId])
  @@index([localId])
  @@index([barberId])
  @@index([date])
}

model WebsiteBanner {
  id         Int               @id @default(autoincrement())
  title      String?
  subtitle   String?
  image      String
  buttonText String?
  buttonUrl  String?
  order      Int               @default(0)
  active     Boolean           @default(true)
  companyId  Int
  type       WebsiteBannerType @default(HOME)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebsiteSetting {
  id              Int     @id @default(autoincrement())
  companyId       Int     @unique
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  facebook        String?
  instagram       String?
  whatsapp        String?
  youtube         String?
  tiktok          String?
  address         String?
  schedule        String?
  footerText      String?
  metaTitle       String?
  metaDescription String?

  ecommerceLocalId Int?

  ecommerceLocal Local? @relation(fields: [ecommerceLocalId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================================================
// RESTAURANTE / COMIDAS: mesas y comandas (pedidos a cocina)
// ==========================================================================

model Mesa {
  id     Int    @id @default(autoincrement())
  name   String
  status String @default("LIBRE") // LIBRE | OCUPADA

  // Posición en el plano/maqueta del salón (px desde la esquina superior izq).
  // null = aún sin ubicar (se muestra en cuadrícula por defecto).
  posX Int?
  posY Int?

  localId   Int
  local     Local   @relation(fields: [localId], references: [id], onDelete: Cascade)
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  comandas Comanda[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([localId])
}

model Comanda {
  id     Int     @id @default(autoincrement())
  // PENDIENTE | PREPARANDO | LISTO | ENTREGADO | COBRADA | CANCELADA
  status String  @default("PENDIENTE")
  notes  String?
  total  Float   @default(0)
  saleId Int? // venta generada al cobrar

  mesaId    Int?
  mesa      Mesa?   @relation(fields: [mesaId], references: [id], onDelete: SetNull)
  localId   Int
  local     Local   @relation(fields: [localId], references: [id], onDelete: Cascade)
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  items ComandaItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([mesaId])
}

model ComandaItem {
  id        Int     @id @default(autoincrement())
  comandaId Int
  comanda   Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)

  inventoryVariantId Int?
  serviceId          Int?
  name               String
  quantity           Float   @default(1)
  price              Float
  subtotal           Float
  notes              String?

  createdAt DateTime @default(now())

  @@index([comandaId])
}

//////////////////////////////////////////////////
// INSUMOS (materia prima para elaborar comida)
// Es control aparte del "Menú" (Inventory): lo que se usa para cocinar
// (harina, carne, aceite...), no lo que se vende directamente.
//////////////////////////////////////////////////

model Supply {
  id       Int     @id @default(autoincrement())
  name     String
  unit     String  @default("UNIDAD") // UNIDAD | KG | GRAMO | LITRO | ML
  stock    Float   @default(0)
  minStock Float? // alerta de bajo (opcional)
  cost     Float   @default(0) // costo por unidad (opcional)
  status   Status  @default(ACTIVO)

  providerId Int?
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  localId    Int
  local      Local     @relation(fields: [localId], references: [id], onDelete: Cascade)
  companyId  Int
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  movements   SupplyMovement[]
  recipeItems RecipeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([localId])
}

// Receta: qué insumos (y cuánto) consume UNA unidad de un plato del menú.
// Al vender el plato se descuentan estos insumos. Solo la usa comida.
model RecipeItem {
  id          Int   @id @default(autoincrement())
  inventoryId Int // el plato
  supplyId    Int // el insumo
  quantity    Float @default(0) // cuánto insumo consume 1 unidad del plato
  companyId   Int

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  supply    Supply    @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([inventoryId, supplyId])
  @@index([inventoryId])
  @@index([supplyId])
  @@index([companyId])
}

model SupplyMovement {
  id        Int     @id @default(autoincrement())
  supplyId  Int
  supply    Supply  @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  type      String // ENTRADA | SALIDA | AJUSTE
  quantity  Float
  reason    String?
  userId    Int?
  companyId Int

  createdAt DateTime @default(now())

  @@index([supplyId])
}

//////////////////////////////////////////////////
// CAJA / ARQUEO
//////////////////////////////////////////////////

enum CashRegisterStatus {
  ABIERTA
  CERRADA
}

enum CashMovementType {
  INGRESO
  EGRESO
}

model CashRegister {
  id             Int                @id @default(autoincrement())
  status         CashRegisterStatus @default(ABIERTA)
  openingAmount  Float              @default(0) // fondo/base inicial
  countedAmount  Float? // efectivo contado al cierre (arqueo)
  expectedAmount Float? // esperado = base + ingresos - egresos
  difference     Float? // contado - esperado
  notes          String?
  openedAt       DateTime           @default(now())
  closedAt       DateTime?

  localId    Int
  local      Local   @relation(fields: [localId], references: [id], onDelete: Cascade)
  companyId  Int
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  openedById Int?
  openedBy   User?   @relation("CashOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  closedById Int?
  closedBy   User?   @relation("CashClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  movements CashMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([localId])
  @@index([status])
}

model CashMovement {
  id      Int              @id @default(autoincrement())
  type    CashMovementType
  amount  Float
  concept String?

  cashRegisterId Int
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)

  saleId Int?
  sale   Sale? @relation(fields: [saleId], references: [id], onDelete: SetNull)

  userId Int?
  user   User? @relation("CashMovementUser", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([cashRegisterId])
}

//////////////////////////////////////////////////
// COMPRAS / ORDENES DE COMPRA
//////////////////////////////////////////////////

enum PurchaseStatus {
  PENDIENTE
  RECIBIDA
  CANCELADA
}

model Purchase {
  id         Int            @id @default(autoincrement())
  code       String
  status     PurchaseStatus @default(PENDIENTE)
  total      Float          @default(0) // total a pagar (base + IVA)
  subtotal   Decimal?       @db.Decimal(14, 2) // base gravable (sin IVA)
  taxTotal   Decimal        @default(0) @db.Decimal(14, 2) // IVA descontable
  notes      String?
  receivedAt DateTime?

  providerId Int?
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  localId    Int
  local      Local     @relation(fields: [localId], references: [id], onDelete: Cascade)
  companyId  Int
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     Int?
  user       User?     @relation("PurchaseUser", fields: [userId], references: [id], onDelete: SetNull)

  items PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([localId])
  @@index([status])
}

model PurchaseItem {
  id                 Int              @id @default(autoincrement())
  purchaseId         Int
  purchase           Purchase         @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  inventoryVariantId Int
  variant            InventoryVariant @relation(fields: [inventoryVariantId], references: [id])
  quantity           Float
  unitCost           Float
  subtotal           Float
  taxRate            Decimal          @default(0) @db.Decimal(5, 2)
  taxAmount          Decimal          @default(0) @db.Decimal(14, 2)

  @@index([purchaseId])
}

//////////////////////////////////////////////////
// COTIZACIONES / PRESUPUESTOS
//////////////////////////////////////////////////

enum QuoteStatus {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  CONVERTIDA
  VENCIDA
}

model Quote {
  id         Int         @id @default(autoincrement())
  code       String
  status     QuoteStatus @default(PENDIENTE)
  total      Float       @default(0)
  notes      String?
  validUntil DateTime?
  saleId     Int? // venta generada al convertir (informativo)

  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  localId    Int
  local      Local     @relation(fields: [localId], references: [id], onDelete: Cascade)
  companyId  Int
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     Int?
  user       User?     @relation("QuoteUser", fields: [userId], references: [id], onDelete: SetNull)

  items QuoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([localId])
  @@index([status])
}

model QuoteItem {
  id                 Int    @id @default(autoincrement())
  quoteId            Int
  quote              Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  inventoryVariantId Int? // snapshot: referencia a la variante (para convertir)
  serviceId          Int?
  name               String
  quantity           Float
  price              Float
  subtotal           Float

  @@index([quoteId])
}

//////////////////////////////////////////////////
// DEVOLUCIONES / NOTAS CREDITO
//////////////////////////////////////////////////

enum ReturnStatus {
  REGISTRADA
  ANULADA
}

model Return {
  id     Int          @id @default(autoincrement())
  code   String
  reason String?
  total  Float        @default(0) // monto devuelto
  status ReturnStatus @default(REGISTRADA)

  saleId    Int
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  localId   Int
  local     Local   @relation(fields: [localId], references: [id], onDelete: Cascade)
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?   @relation("ReturnUser", fields: [userId], references: [id], onDelete: SetNull)

  items ReturnItem[]

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([saleId])
}

model ReturnItem {
  id                 Int    @id @default(autoincrement())
  returnId           Int
  return             Return @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId         Int?
  inventoryVariantId Int?
  name               String
  quantity           Float
  price              Float
  subtotal           Float

  @@index([returnId])
}

//////////////////////////////////////////////////
// CARGOS AL EMPLEADO (cuenta del barbero): valores
// que el empleado debe responder al negocio —
// error de membresía, préstamo, producto llevado…
// Se puede saldar en efectivo o descontar de comisiones.
enum EmployeeChargeType {
  MEMBRESIA
  PRESTAMO
  PRODUCTO
  OTRO
}

model EmployeeCharge {
  id        Int                @id @default(autoincrement())
  companyId Int
  userId    Int // empleado/barbero que debe
  type      EmployeeChargeType @default(OTRO)
  // Categoría administrable por el negocio (opcional); `type` se deriva de ella.
  chargeCategoryId Int?
  chargeCategory   ChargeCategory? @relation(fields: [chargeCategoryId], references: [id], onDelete: SetNull)
  concept   String
  amount    Float
  notes     String?
  // PENDIENTE (debe) | PAGADO (respondió efectivo) | DESCONTADO (de comisión)
  status        String    @default("PENDIENTE")
  settledMethod String? // EFECTIVO | COMISION
  settledAt     DateTime?
  saleId        Int? // opcional: venta que originó el cargo (ej. membresía)
  createdById   Int?
  createdByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([userId])
  @@index([status])
}

// Suscripción Web Push de un usuario (para notificaciones a la PWA por rol).
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  companyId Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([companyId])
}

// CUENTAS POR PAGAR: algo pendiente de pagar (proveedor, servicio, etc.) con su
// fecha de vencimiento. Al pagarlo se genera un Gasto con la fecha del pago.
model Payable {
  id        Int          @id @default(autoincrement())
  companyId Int
  localId   Int
  concept   String
  paidTo    String? // proveedor / a quién se le paga
  type      ExpenseType  @default(OTROS) // categoría (misma del gasto)
  amount    Float
  dueDate   DateTime? // cuándo se debe pagar (vencimiento)
  notes     String?
  // PENDIENTE (por pagar) | PAGADO (ya se pagó → generó gasto)
  status        String         @default("PENDIENTE")
  paidAt        DateTime? // fecha real del pago
  paymentMethod PaymentMethod?
  expenseId     Int? // gasto generado al pagar
  createdById   Int?
  createdByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
}

// Configuración de facturación electrónica DIAN vía proveedor tecnológico (Factus).
// Las credenciales viven por empresa en BD (no en el código, que es público).
model FactusConfig {
  id                  Int       @id @default(autoincrement())
  companyId           Int       @unique
  enabled             Boolean   @default(false)
  environment         String    @default("SANDBOX") // SANDBOX | PRODUCTION
  clientId            String?
  clientSecret        String?
  username            String?
  password            String?
  numberingRangeId    Int?
  paymentMethodCode   String    @default("10") // 10 = contado
  legalOrganizationId String    @default("2") // 1 jurídica, 2 natural
  tributeId           String    @default("21") // 21 = No responsable de IVA
  municipalityId      String?
  unitMeasureId       String    @default("70") // 70 = unidad
  accessToken         String?
  refreshToken        String?
  tokenExpiresAt      DateTime?
  testedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// Resultado de emitir la factura electrónica de una venta.
model ElectronicInvoice {
  id          Int       @id @default(autoincrement())
  companyId   Int
  saleId      Int       @unique
  provider    String    @default("FACTUS")
  number      String?
  cufe        String?
  status      String    @default("PENDIENTE") // PENDIENTE | EMITIDA | ERROR
  qrUrl       String?
  pdfUrl      String?
  xmlUrl      String?
  validatedAt DateTime?
  error       String?
  raw         Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
}

// Auditoría de accesos de soporte: cada vez que la plataforma "entra como" una
// empresa (impersonación) se registra aquí, para trazabilidad. No lleva FKs a
// propósito (se conserva aunque se borre la empresa/usuario).
model ImpersonationLog {
  id           Int      @id @default(autoincrement())
  companyId    Int
  companyName  String
  actorId      Int // usuario de plataforma que impersonó
  actorEmail   String?
  targetUserId Int // dueño (SUPER_ADMIN) al que se entró
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([companyId])
}

// Comunicados/anuncios de la PLATAFORMA hacia los negocios. Se pueden dirigir a
// todos, o segmentar por tipo de negocio y/o por plan (nada mezclado: cada
// negocio solo ve lo que le corresponde). Ventana opcional de vigencia.
model Announcement {
  id        Int       @id @default(autoincrement())
  title     String
  body      String
  level     String    @default("INFO") // INFO | SUCCESS | WARNING | CRITICAL
  audience  String    @default("ALL") // ALL | TYPE | PLAN
  types     String[]  @default([]) // claves de BusinessType si audience=TYPE
  plans     String[]  @default([]) // ids de plan si audience=PLAN
  ctaLabel  String?
  ctaUrl    String?
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active])
}

// Pagos de suscripción (upgrade de plan vía Wompi Web Checkout). Cada intento
// crea una fila PENDING; el webhook de Wompi la pasa a APPROVED y activa el
// plan de la empresa (plan + monthlyPrice + paidUntil +30 días).
model SubscriptionPayment {
  id            Int      @id @default(autoincrement())
  companyId     Int
  plan          String
  amount        Int // COP
  reference     String   @unique
  status        String   @default("PENDING") // PENDING | APPROVED | DECLINED | VOIDED | ERROR
  transactionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
}

// Configuración editable de cada TIPO DE NEGOCIO (vertical): su etiqueta y el
// set de módulos que trae por defecto. Es GLOBAL (no por empresa) y la gestiona
// el rol plataforma. `type` = clave del enum BusinessType. Reemplaza al mapa
// hardcode del front (businessTypes.js) cuando existe; si no, el front usa el
// hardcode como respaldo. El override por empresa (Company.enabledModules)
// sigue mandando sobre esto.
model BusinessTypeConfig {
  id        Int      @id @default(autoincrement())
  type      String   @unique
  label     String
  modules   String[] @default([])
  // Configuración avanzada por tipo (opcional; si null/vacío, el front usa su
  // mapa por defecto). terminology: overrides de vocabulario; productFields:
  // qué campos de producto aplican; roles: roles asignables del tipo.
  terminology  Json?
  productFields Json?
  roles        String[] @default([])
  // Valores por defecto que se aplican al CREAR una empresa de este tipo
  // (requireCashOpen, openHour, closeHour, loyaltyEnabled). Editables.
  defaults     Json?
  // Ajustes de la TIENDA online por tipo: modos de entrega (fulfillment) y
  // layout del catálogo. Lo consume el storefront vía /website/config.
  storefront   Json?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
