generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Cambia a mysql o sqlite si usas otro
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////

enum Role {
  SUPER_ADMIN
  COORDINADOR
  ADMIN
  ASESOR
  AUXILIAR
  BODEGUERO
  VENTAS
  SUPER_PLATFORM_ADMIN
  BARBERO
  CAJA
  RECEPCIONISTA
  MESERO
  COCINERO
  PROFESIONAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id        Int         @id @default(autoincrement())
  entity    String
  entityId  Int
  action    AuditAction
  changes   Json?
  userId    Int?
  userName  String
  companyId Int
  createdAt DateTime    @default(now())

  @@index([entity, entityId])
  @@index([companyId])
}

enum Status {
  ACTIVO
  INACTIVO
  PENDIENTE
  ELIMINADO
}

enum PaymentMethod {
  EFECTIVO
  BANCOLOMBIA
  TRANSFERENCIA
  DATAFONO
  ADDI
  CREDITO
}

enum PaymentStatus {
  PENDIENTE
  EN_VALIDACION
  PLAN_SEPARE
  PAGADA
  RECHAZADA
  VENCIDO
  REEMBOLSADO
  ANULADO
  FIADO
}

enum SaleStatus {
  NUEVA
  EN_PROCESO
  PENDIENTE
  APROBADA
  RECHAZADA
  CANCELADA
  FACTURADA
  DESPACHADA
  ENTREGADA
  DEVUELTA
}

enum ExpenseType {
  ARRIENDO
  SERVICIOS_PUBLICOS
  EMPLEADOS
  TRANSPORTE
  PEDIDOS
  PLAN_CELULAR
  PLAN_INTERNET
  ASEO
  MANTENIMIENTO
  PUBLICIDAD
  IMPUESTOS
  COMISIONES
  OTROS
}

enum OrderSource {
  CRM
  ECOMMERCE
}

enum ShippingStatus {
  PENDIENTE
  ASIGNADO_TRANSPORTADORA
  EN_CAMINO
  ENTREGADO
  DEVUELTO
  FALLIDO
}

enum BusinessType {
  COMERCIO
  FERIA
  TELEVENTAS
  RESTAURANTE
  SERVICIOS
  ECOMMERCE
  DISTRIBUCION
  ZORVEX
  // Verticales específicas (multi-negocio)
  ODONTOLOGIA
  SUPERMERCADO
  DROGUERIA
  ROPA
  FRUVER
  FLORISTERIA
  COMIDA_RAPIDA
  CAFETERIA
  CARNICERIA
}

enum DiscountType {
  PERCENT // porcentaje sobre el precio del plan (0-100)
  FIXED // monto fijo en COP
}

// Cupones de descuento gestionados por el SUPER_PLATFORM_ADMIN. Se pueden
// aplicar en el registro para descontar sobre el precio del plan elegido.
model Coupon {
  id             Int          @id @default(autoincrement())
  code           String       @unique
  description    String?
  discountType   DiscountType @default(PERCENT)
  discountValue  Int          @default(0) // % (0-100) o monto fijo en COP
  appliesToPlan  String? // null = todos los planes; o un id de plan (DESPEGUE, IMPULSO, ...)
  maxRedemptions Int? // null = ilimitado
  timesRedeemed  Int          @default(0)
  expiresAt      DateTime? // null = sin vencimiento
  active         Boolean      @default(true)
  status         Status       @default(ACTIVO) // para borrado lógico
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum AppointmentStatus {
  PENDIENTE
  CONFIRMADA
  EN_PROCESO
  COMPLETADA
  CANCELADA
  NO_ASISTIO
}

enum WebsiteBannerType {
  HOME
  CATEGORY
  OFFER
  POPUP
}

// Tipo de factura (normal vs electrónica DIAN).
enum InvoiceType {
  NORMAL
  ELECTRONICA
}

//////////////////////////////////////////////////
// MODELOS
//////////////////////////////////////////////////

model Company {
  id      Int          @id @default(autoincrement())
  name    String
  logo    String?
  nit     String?
  email   String?
  type    BusinessType @default(COMERCIO)
  status  Status       @default(ACTIVO)
  phone   String?
  manager String?

  // Fidelización por visitas con dos escalones de descuento. Ej. barbería:
  // a la visita 4 -> 50% en ese corte, a la visita 8 -> 100% (y reinicia).
  // Entre visita y visita hay un máximo de días; si se pasa, la racha reinicia.
  loyaltyEnabled      Boolean @default(false)
  loyaltyTier1Visits  Int     @default(4)
  loyaltyTier1Percent Int     @default(50)
  loyaltyTier2Visits  Int     @default(8)
  loyaltyTier2Percent Int     @default(100)
  loyaltyMaxDays      Int     @default(25)

  // (Legado) esquema anterior de sellos + premio; se conserva por compatibilidad.
  loyaltyStampsRequired Int    @default(10)
  loyaltyReward         String @default("1 servicio gratis")

  // Horario de atención (hora 0-23) — usado por la disponibilidad de citas.
  openHour  Int @default(9)
  closeHour Int @default(20)

  // Tema de diseño del panel/CRM elegido por el dueño (orange | blue | emerald).
  crmTheme String @default("orange")

  // Overrides de vocabulario propios de la empresa (barbería vs estética, etc.).
  // Se fusionan sobre los términos por tipo de negocio. Ej: { "attendant": "Especialista" }
  terminology Json?

  // Si está activo, no se puede vender sin haber "abierto el día" (caja abierta
  // de hoy en la sede). El dueño lo enciende/apaga en Configuración.
  requireCashOpen Boolean @default(false)

  // Configuración fiscal (facturación con impuestos / electrónica DIAN).
  responsableIVA     Boolean @default(false)
  preciosIncluyenIVA Boolean @default(false)
  defaultTaxRate     Decimal @default(0) @db.Decimal(5, 2)
  businessName       String?
  dv                 String?
  personType         String?
  taxRegime          String?
  ciiu               String?
  fiscalAddress      String?
  fiscalCity         String?

  // Facturación / suscripción (control de la plataforma)
  plan       String?
  paidUntil  DateTime? // fecha hasta la que la empresa está al día; si vence, se auto-suspende
  startDate  DateTime? // fecha en que la empresa empezó con nosotros (si null, se usa createdAt)
  couponCode String? // cupón de descuento con el que se registró (informativo)

  //////////////////////////////////////////////////
  // WEBSITE
  //////////////////////////////////////////////////

  domain         String? @unique
  slug           String? @unique
  websiteEnabled Boolean @default(false)
  websiteName    String?
  favicon        String?
  theme          String  @default("default")
  fontFamily     String? // tipografía de la tienda (clave, no la fuente completa)
  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  ctaColor       String? // color de los botones de compra
  heroTitle      String?
  heroSubtitle   String?

  //////////////////////////////////////////////////

  users          User[]
  locals         Local[]
  provider       Provider[]
  categories     Category[]
  brand          Brand[]
  customers      Customer[]
  services       Service[]
  appointments   Appointment[]
  websiteBanners WebsiteBanner[]
  websiteSetting WebsiteSetting?
  mesas          Mesa[]
  comandas       Comanda[]
  salePayments   SalePayment[]
  inventory      Inventory[]     @relation("CompanyInventory")
  cashRegisters  CashRegister[]
  purchases      Purchase[]
  quotes         Quote[]
  returns        Return[]
  supplies       Supply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id         Int       @id @default(autoincrement())
  role       Role      @default(ASESOR)
  name       String    @default("SIN NOMBRE")
  email      String    @unique
  phone      String?
  address    String?
  birthdate  DateTime?
  document   String?
  department String?
  city       String?
  status     Status    @default(ACTIVO)
  password   String
  avatar     String?

  // Código OTP para restablecer contraseña por celular (WhatsApp)
  resetOtpHash     String?
  resetOtpExpires  DateTime?
  resetOtpAttempts Int       @default(0)

  localId Int?
  local   Local? @relation("LocalUsers", fields: [localId], references: [id], onDelete: SetNull)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  managedLocals      Local[]       @relation("LocalManager")
  createdInventories Inventory[]   @relation("InventoryCreatedBy")
  updatedInventories Inventory[]   @relation("InventoryUpdatedBy")
  services           Service[]     @relation("BarberServices")
  appointments       Appointment[] @relation("BarberAppointments")

  sales    Sale[]    @relation("UserSales")
  comandas Comanda[]

  cashOpened    CashRegister[] @relation("CashOpenedBy")
  cashClosed    CashRegister[] @relation("CashClosedBy")
  cashMovements CashMovement[] @relation("CashMovementUser")
  salePayments  SalePayment[]  @relation("UserSalePayments")
  purchases     Purchase[]     @relation("PurchaseUser")
  quotes        Quote[]        @relation("QuoteUser")
  returns       Return[]       @relation("ReturnUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////

model Customer {
  id            Int     @id @default(autoincrement())
  type_document String?
  document      String?
  name          String
  email         String?
  phone         String?
  department    String?
  city          String?
  address       String?
  status        Status  @default(ACTIVO)

  // Fecha de nacimiento (para campañas de cumpleaños) y notas del asesor
  // (preferencias, observaciones del cliente).
  birthday DateTime?
  notes    String?

  // Fidelización: sellos acumulados hacia el próximo premio y premios ganados
  // pendientes de canjear.
  loyaltyStamps    Int       @default(0)
  loyaltyRewards   Int       @default(0)
  loyaltyLastVisit DateTime? // última visita que sumó a la fidelización
  // Cliente "graduado": ya completó el rango de fidelización (llegó al tope).
  // La fidelización queda desactivada para él de forma permanente (ya es
  // cliente antiguo y paga normal); se lista aparte para futuras ofertas.
  loyaltyCompleted Boolean   @default(false)

  // Última vez que se le escribió para reactivarlo (campaña de win-back).
  lastWinbackAt DateTime?

  localId Int?
  local   Local? @relation(fields: [localId], references: [id], onDelete: SetNull)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  sales        Sale[]        @relation("CustomerSales")
  appointments Appointment[]
  quotes       Quote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([document, companyId])
}

//////////////////////////////////////////////////

model Provider {
  id          Int     @id @default(autoincrement())
  name        String
  contactName String?
  phone       String?
  email       String?
  city        String?
  department  String?
  address     String?
  productType String?
  status      Status  @default(ACTIVO)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  inventories Inventory[] @relation("ProviderProducts")
  expenses    Expense[]   @relation("ProviderExpenses")
  purchases   Purchase[]
  supplies    Supply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////

model Local {
  id         Int     @id @default(autoincrement())
  name       String
  address    String?
  department String?
  city       String?
  phone      String?
  status     Status  @default(ACTIVO)

  managerId Int?
  manager   User? @relation("LocalManager", fields: [managerId], references: [id])

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  users           User[]           @relation("LocalUsers")
  inventories     Inventory[]      @relation("LocalInventory")
  expenses        Expense[]        @relation("LocalExpenses")
  sales           Sale[]           @relation("LocalSales")
  categories      Category[]       @relation("LocalCategory")
  brand           Brand[]          @relation("LocalBrand")
  appointments    Appointment[]
  customers       Customer[]
  serviceLocals   ServiceLocal[]
  websiteSettings WebsiteSetting[]
  mesas           Mesa[]
  comandas        Comanda[]
  cashRegisters   CashRegister[]
  purchases       Purchase[]
  quotes          Quote[]
  returns         Return[]
  supplies        Supply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////

model Category {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  status      Status  @default(ACTIVO)
  localId     Int?

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  inventories Inventory[] @relation("CategoryProducts")
  local       Local?      @relation("LocalCategory", fields: [localId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////

model Brand {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  status      Status  @default(ACTIVO)
  localId     Int?

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  inventories Inventory[] @relation("BrandProducts")
  local       Local?      @relation("LocalBrand", fields: [localId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////

model Inventory {
  id                 Int     @id @default(autoincrement())
  name               String
  description        String?
  slug               String? @unique
  purchasePrice      Float
  oldPrice           Float?
  salePrice          Float
  taxRate            Decimal @default(0) @db.Decimal(5, 2)
  status             Status  @default(ACTIVO)
  barcode            String? @unique
  publishInEcommerce Boolean @default(false)

  // Umbral de alerta de stock bajo (0 = sin alerta). Se compara contra el stock
  // total del producto (suma de variantes).
  minStock Int @default(0)

  // Unidad de venta: UNIDAD (por unidad) o PESO (por kg, admite decimales).
  unit String @default("UNIDAD")

  // ¿Se controla el inventario/stock de este producto? (como el "Track quantity"
  // de Shopify/Square). true = producto con existencias (bebidas, retail); false
  // = elaborado al momento sin stock (platos de un menú), se puede vender siempre.
  trackStock Boolean @default(true)

  // Vencimiento y lote (droguería / perecederos). Opcionales.
  expiryDate DateTime?
  lot        String?

  // Ancla de tenant: el producto pertenece a una empresa (no depende del local,
  // que puede quedar en null si se borra la sede). Nullable por 3 filas antiguas
  // huérfanas sin empresa resoluble; los productos nuevos siempre lo llevan.
  companyId  Int?
  localId    Int?
  providerId Int?
  categoryId Int?
  brandId    Int?

  createdById Int?
  updatedById Int?

  createdBy User?     @relation("InventoryCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("InventoryUpdatedBy", fields: [updatedById], references: [id])
  company   Company?  @relation("CompanyInventory", fields: [companyId], references: [id], onDelete: Cascade)
  local     Local?    @relation("LocalInventory", fields: [localId], references: [id], onDelete: SetNull)
  provider  Provider? @relation("ProviderProducts", fields: [providerId], references: [id], onDelete: SetNull)
  category  Category? @relation("CategoryProducts", fields: [categoryId], references: [id], onDelete: SetNull)
  brand     Brand?    @relation("BrandProducts", fields: [brandId], references: [id], onDelete: SetNull)

  variants       InventoryVariant[]
  images         InventoryImage[]
  features       InventoryFeature[]
  specifications InventorySpecification[]
  recipeItems    RecipeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([localId])
  @@index([categoryId])
  @@index([brandId])
  @@index([providerId])
  @@index([status])
}

model InventoryVariant {
  id       Int     @id @default(autoincrement())
  sequence Int     @unique @default(autoincrement())
  color    String
  size     String? // talla (ropa/calzado); opcional
  stock    Float   @default(0) // admite decimales para venta por peso (kg)
  sku      String  @unique

  isActive Boolean @default(true)

  inventoryId Int

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryImage {
  id          Int    @id @default(autoincrement())
  url         String
  publicId    String
  inventoryId Int
  position    Int    @default(0)

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model InventoryFeature {
  id          Int    @id @default(autoincrement())
  title       String
  inventoryId Int
  order       Int    @default(0)

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model InventorySpecification {
  id          Int    @id @default(autoincrement())
  key         String
  value       String
  inventoryId Int
  order       Int    @default(0)

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

//////////////////////////////////////////////////

model Expense {
  id            Int            @id @default(autoincrement())
  concept       String
  type          ExpenseType
  amount        Float
  paymentMethod PaymentMethod?
  paidTo        String?
  notes         String?
  status        Status         @default(ACTIVO)
  expenseDate   DateTime

  providerId Int?
  localId    Int

  provider Provider? @relation("ProviderExpenses", fields: [providerId], references: [id], onDelete: SetNull)
  local    Local     @relation("LocalExpenses", fields: [localId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([localId])
  @@index([expenseDate])
  @@index([type])
}

//////////////////////////////////////////////////

model Sale {
  id            Int           @id @default(autoincrement())
  code          String        @unique
  totalAmount   Float
  subtotal      Decimal?      @db.Decimal(14, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(14, 2)
  invoiceType   InvoiceType   @default(NORMAL)
  paymentMethod PaymentMethod
  saleStatus    SaleStatus    @default(NUEVA)
  paymentStatus PaymentStatus @default(PENDIENTE)
  saleDate      DateTime      @default(now())
  dueDate       DateTime? // vencimiento de la venta a crédito (fiado)
  notes         String?
  cashReceived  Float? // efectivo con el que pagó el cliente (para calcular el cambio en la factura)

  source              OrderSource @default(CRM)
  ecommerceCustomerId Int?

  shippingStatus ShippingStatus @default(PENDIENTE)

  wompiTransactionId String?
  wompiReference     String?
  wompiStatus        String?
  wompiPayload       Json?

  customerId    Int?
  localId       Int
  userId        Int?
  appointmentId Int?

  ecommerceCustomer EcommerceCustomer? @relation("EcommerceOrders", fields: [ecommerceCustomerId], references: [id])

  local       Local        @relation("LocalSales", fields: [localId], references: [id], onDelete: Cascade)
  user        User?        @relation("UserSales", fields: [userId], references: [id], onDelete: SetNull)
  customer    Customer?    @relation("CustomerSales", fields: [customerId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation("AppointmentSales", fields: [appointmentId], references: [id])

  items SaleItem[] @relation("SaleItems")

  shipment Shipment?

  cashMovements CashMovement[]
  returns       Return[]
  payments      SalePayment[]  @relation("SalePayments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([localId])
  @@index([userId])
  @@index([saleDate])
  @@index([customerId])
  @@index([paymentStatus])
}

//////////////////////////////////////////////////
// Abonos / pagos parciales de una venta a crédito (cartera / fiado)
//////////////////////////////////////////////////

model SalePayment {
  id     Int           @id @default(autoincrement())
  amount Decimal       @db.Decimal(14, 2)
  method PaymentMethod @default(EFECTIVO)
  note   String?
  paidAt DateTime      @default(now())

  saleId      Int
  companyId   Int
  createdById Int?

  sale      Sale    @relation("SalePayments", fields: [saleId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("UserSalePayments", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([companyId])
}

//////////////////////////////////////////////////
// Tabla intermedia para los productos vendidos
//////////////////////////////////////////////////

model SaleItem {
  id        Int     @id @default(autoincrement())
  quantity  Float // admite decimales para venta por peso (kg)
  price     Float
  subtotal  Float
  discount  Float   @default(0)
  taxRate   Decimal @default(0) @db.Decimal(5, 2)
  taxAmount Decimal @default(0) @db.Decimal(14, 2)

  saleId             Int
  inventoryVariantId Int?
  serviceId          Int?

  sale    Sale              @relation("SaleItems", fields: [saleId], references: [id], onDelete: Cascade)
  variant InventoryVariant? @relation(fields: [inventoryVariantId], references: [id])
  service Service?          @relation(fields: [serviceId], references: [id])

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([inventoryVariantId])
  @@index([serviceId])
}

//////////////////////////////////////////////////
// ECOMMERCE
//////////////////////////////////////////////////

model EcommerceCustomer {
  id Int @id @default(autoincrement())

  email     String @unique
  firstName String
  lastName  String
  phone     String

  documentNumber String?

  department    String
  city          String
  address       String
  addressDetail String?
  neighborhood  String?

  billingSameAsShipping Boolean @default(true)
  billingFirstName      String?
  billingLastName       String?
  billingPhone          String?
  billingAddress        String?

  isHardToAccess Boolean @default(false)

  localId Int @default(3)

  orders Sale[] @relation("EcommerceOrders")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shipment {
  id Int @id @default(autoincrement())

  saleId Int            @unique
  status ShippingStatus @default(PENDIENTE)

  carrier        String?
  trackingNumber String?

  shippedAt   DateTime?
  deliveredAt DateTime?
  notes       String?

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// BARBERIA

model Service {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  duration    Int
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  status      Status  @default(ACTIVO)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  serviceLocals ServiceLocal[]

  barbers      User[]        @relation("BarberServices")
  appointments Appointment[]
  saleItems    SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceLocal {
  id Int @id @default(autoincrement())

  price Float

  serviceId Int
  localId   Int

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  local   Local   @relation(fields: [localId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([serviceId, localId])
}

model Appointment {
  id Int @id @default(autoincrement())

  date      DateTime
  startTime String

  status AppointmentStatus @default(CONFIRMADA)
  notes  String?

  // Confirmación explícita con el cliente (p. ej. tras contactarlo por WhatsApp).
  clientConfirmed Boolean @default(false)

  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id])

  barberId Int
  barber   User @relation("BarberAppointments", fields: [barberId], references: [id])

  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id])

  localId Int
  local   Local @relation(fields: [localId], references: [id])

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[] @relation("AppointmentSales")

  @@index([serviceId])
  @@index([companyId])
  @@index([localId])
  @@index([barberId])
  @@index([date])
}

model WebsiteBanner {
  id         Int               @id @default(autoincrement())
  title      String?
  subtitle   String?
  image      String
  buttonText String?
  buttonUrl  String?
  order      Int               @default(0)
  active     Boolean           @default(true)
  companyId  Int
  type       WebsiteBannerType @default(HOME)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebsiteSetting {
  id              Int     @id @default(autoincrement())
  companyId       Int     @unique
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  facebook        String?
  instagram       String?
  whatsapp        String?
  youtube         String?
  tiktok          String?
  address         String?
  schedule        String?
  footerText      String?
  metaTitle       String?
  metaDescription String?

  ecommerceLocalId Int?

  ecommerceLocal Local? @relation(fields: [ecommerceLocalId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================================================
// RESTAURANTE / COMIDAS: mesas y comandas (pedidos a cocina)
// ==========================================================================

model Mesa {
  id     Int    @id @default(autoincrement())
  name   String
  status String @default("LIBRE") // LIBRE | OCUPADA

  localId   Int
  local     Local   @relation(fields: [localId], references: [id], onDelete: Cascade)
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  comandas Comanda[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([localId])
}

model Comanda {
  id     Int     @id @default(autoincrement())
  // PENDIENTE | PREPARANDO | LISTO | ENTREGADO | COBRADA | CANCELADA
  status String  @default("PENDIENTE")
  notes  String?
  total  Float   @default(0)
  saleId Int? // venta generada al cobrar

  mesaId    Int?
  mesa      Mesa?   @relation(fields: [mesaId], references: [id], onDelete: SetNull)
  localId   Int
  local     Local   @relation(fields: [localId], references: [id], onDelete: Cascade)
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  items ComandaItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([mesaId])
}

model ComandaItem {
  id        Int     @id @default(autoincrement())
  comandaId Int
  comanda   Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)

  inventoryVariantId Int?
  serviceId          Int?
  name               String
  quantity           Float   @default(1)
  price              Float
  subtotal           Float
  notes              String?

  createdAt DateTime @default(now())

  @@index([comandaId])
}

//////////////////////////////////////////////////
// INSUMOS (materia prima para elaborar comida)
// Es control aparte del "Menú" (Inventory): lo que se usa para cocinar
// (harina, carne, aceite...), no lo que se vende directamente.
//////////////////////////////////////////////////

model Supply {
  id       Int     @id @default(autoincrement())
  name     String
  unit     String  @default("UNIDAD") // UNIDAD | KG | GRAMO | LITRO | ML
  stock    Float   @default(0)
  minStock Float? // alerta de bajo (opcional)
  cost     Float   @default(0) // costo por unidad (opcional)
  status   Status  @default(ACTIVO)

  providerId Int?
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  localId    Int
  local      Local     @relation(fields: [localId], references: [id], onDelete: Cascade)
  companyId  Int
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  movements   SupplyMovement[]
  recipeItems RecipeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([localId])
}

// Receta: qué insumos (y cuánto) consume UNA unidad de un plato del menú.
// Al vender el plato se descuentan estos insumos. Solo la usa comida.
model RecipeItem {
  id          Int   @id @default(autoincrement())
  inventoryId Int // el plato
  supplyId    Int // el insumo
  quantity    Float @default(0) // cuánto insumo consume 1 unidad del plato
  companyId   Int

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  supply    Supply    @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([inventoryId, supplyId])
  @@index([inventoryId])
  @@index([supplyId])
  @@index([companyId])
}

model SupplyMovement {
  id        Int     @id @default(autoincrement())
  supplyId  Int
  supply    Supply  @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  type      String // ENTRADA | SALIDA | AJUSTE
  quantity  Float
  reason    String?
  userId    Int?
  companyId Int

  createdAt DateTime @default(now())

  @@index([supplyId])
}

//////////////////////////////////////////////////
// CAJA / ARQUEO
//////////////////////////////////////////////////

enum CashRegisterStatus {
  ABIERTA
  CERRADA
}

enum CashMovementType {
  INGRESO
  EGRESO
}

model CashRegister {
  id             Int                @id @default(autoincrement())
  status         CashRegisterStatus @default(ABIERTA)
  openingAmount  Float              @default(0) // fondo/base inicial
  countedAmount  Float? // efectivo contado al cierre (arqueo)
  expectedAmount Float? // esperado = base + ingresos - egresos
  difference     Float? // contado - esperado
  notes          String?
  openedAt       DateTime           @default(now())
  closedAt       DateTime?

  localId    Int
  local      Local   @relation(fields: [localId], references: [id], onDelete: Cascade)
  companyId  Int
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  openedById Int?
  openedBy   User?   @relation("CashOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  closedById Int?
  closedBy   User?   @relation("CashClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  movements CashMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([localId])
  @@index([status])
}

model CashMovement {
  id      Int              @id @default(autoincrement())
  type    CashMovementType
  amount  Float
  concept String?

  cashRegisterId Int
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)

  saleId Int?
  sale   Sale? @relation(fields: [saleId], references: [id], onDelete: SetNull)

  userId Int?
  user   User? @relation("CashMovementUser", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([cashRegisterId])
}

//////////////////////////////////////////////////
// COMPRAS / ORDENES DE COMPRA
//////////////////////////////////////////////////

enum PurchaseStatus {
  PENDIENTE
  RECIBIDA
  CANCELADA
}

model Purchase {
  id         Int            @id @default(autoincrement())
  code       String
  status     PurchaseStatus @default(PENDIENTE)
  total      Float          @default(0) // total a pagar (base + IVA)
  subtotal   Decimal?       @db.Decimal(14, 2) // base gravable (sin IVA)
  taxTotal   Decimal        @default(0) @db.Decimal(14, 2) // IVA descontable
  notes      String?
  receivedAt DateTime?

  providerId Int?
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  localId    Int
  local      Local     @relation(fields: [localId], references: [id], onDelete: Cascade)
  companyId  Int
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     Int?
  user       User?     @relation("PurchaseUser", fields: [userId], references: [id], onDelete: SetNull)

  items PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([localId])
  @@index([status])
}

model PurchaseItem {
  id                 Int              @id @default(autoincrement())
  purchaseId         Int
  purchase           Purchase         @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  inventoryVariantId Int
  variant            InventoryVariant @relation(fields: [inventoryVariantId], references: [id])
  quantity           Float
  unitCost           Float
  subtotal           Float
  taxRate            Decimal          @default(0) @db.Decimal(5, 2)
  taxAmount          Decimal          @default(0) @db.Decimal(14, 2)

  @@index([purchaseId])
}

//////////////////////////////////////////////////
// COTIZACIONES / PRESUPUESTOS
//////////////////////////////////////////////////

enum QuoteStatus {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  CONVERTIDA
  VENCIDA
}

model Quote {
  id         Int         @id @default(autoincrement())
  code       String
  status     QuoteStatus @default(PENDIENTE)
  total      Float       @default(0)
  notes      String?
  validUntil DateTime?
  saleId     Int? // venta generada al convertir (informativo)

  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  localId    Int
  local      Local     @relation(fields: [localId], references: [id], onDelete: Cascade)
  companyId  Int
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     Int?
  user       User?     @relation("QuoteUser", fields: [userId], references: [id], onDelete: SetNull)

  items QuoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([localId])
  @@index([status])
}

model QuoteItem {
  id                 Int    @id @default(autoincrement())
  quoteId            Int
  quote              Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  inventoryVariantId Int? // snapshot: referencia a la variante (para convertir)
  serviceId          Int?
  name               String
  quantity           Float
  price              Float
  subtotal           Float

  @@index([quoteId])
}

//////////////////////////////////////////////////
// DEVOLUCIONES / NOTAS CREDITO
//////////////////////////////////////////////////

enum ReturnStatus {
  REGISTRADA
  ANULADA
}

model Return {
  id     Int          @id @default(autoincrement())
  code   String
  reason String?
  total  Float        @default(0) // monto devuelto
  status ReturnStatus @default(REGISTRADA)

  saleId    Int
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  localId   Int
  local     Local   @relation(fields: [localId], references: [id], onDelete: Cascade)
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?   @relation("ReturnUser", fields: [userId], references: [id], onDelete: SetNull)

  items ReturnItem[]

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([saleId])
}

model ReturnItem {
  id                 Int    @id @default(autoincrement())
  returnId           Int
  return             Return @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId         Int?
  inventoryVariantId Int?
  name               String
  quantity           Float
  price              Float
  subtotal           Float

  @@index([returnId])
}
